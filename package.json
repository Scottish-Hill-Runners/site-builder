{
  "name": "shr-web-builder",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "prebuild": "node scripts/run-builds.mjs",
    "content:sync": "node scripts/sync-content.mjs",
    "content:build": "npm run prebuild",
    "validate:results": "tsx scripts/validate-results.ts",
    "validate:results:content": "tsx scripts/validate-results.ts",
    "validate:results:strict": "tsx scripts/validate-results.ts --strict-filenames --warnings-as-errors",
    "dev": "next dev",
    "build": "npm run prebuild && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.2.5",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-virtual": "^3.13.24",
    "@tmcw/togeojson": "^7.1.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "csvtojson": "^2.0.14",
    "gray-matter": "^4.0.3",
    "maplibre-gl": "^6.10.0",
    "markdown-it": "^14.2.0",
    "next": "^16.2.6",
    "papaparse": "^5.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-obfuscate": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "yaml": "^2.7.1"
  },
  "overrides": {
    "postcss": "~8.5.10",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "csv-parse": "^7.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "tailwindcss": "^4",
    "tsx": "^4",
    "turndown": "^7.1.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
