{
  "redirects": [
    {
      "source": "/(.*)\\.aspx",
      "destination": "/welcome",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.json\\.gz)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
